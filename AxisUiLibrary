local function setCloseHover(hovered)
    local activeTheme = window.Theme or theme

    if hovered then
        tween(close, {
            BackgroundColor3 = activeTheme.SurfaceHover,
            BackgroundTransparency = 0
        }, 0.22)
        tween(closeStroke, {
            Color = closeAccent,
            Transparency = 0.16,
            Thickness = 1.25
        }, 0.22)
        tween(closeGlow, {
            BackgroundTransparency = 0.72
        }, 0.2)
        tween(closeIcon, {
            Rotation = 90
        }, 0.32)
        tween(closeLineA, {
            BackgroundColor3 = closeAccent,
            Size = UDim2.fromOffset(16, 2)
        }, 0.2)
        tween(closeLineB, {
            BackgroundColor3 = closeAccent,
            Size = UDim2.fromOffset(16, 2)
        }, 0.2)
        return
    end

    tween(close, {
        BackgroundColor3 = activeTheme.Surface,
        BackgroundTransparency = 0.08
    }, 0.2)
    tween(closeStroke, {
        Color = activeTheme.Border,
        Transparency = 0.52,
        Thickness = 1
    }, 0.2)
    tween(closeGlow, {
        BackgroundTransparency = 1
    }, 0.18)
    tween(closeIcon, {
        Rotation = 0
    }, 0.28)
    tween(closeLineA, {
        BackgroundColor3 = activeTheme.Muted,
        Size = UDim2.fromOffset(14, 2)
    }, 0.18)
    tween(closeLineB, {
        BackgroundColor3 = activeTheme.Muted,
        Size = UDim2.fromOffset(14, 2)
    }, 0.18)
end

close.MouseEnter:Connect(function()
    setCloseHover(true)
end)

close.MouseLeave:Connect(function()
    setCloseHover(false)
end)

close.MouseButton1Click:Connect(function()
    tween(closeGlow, {
        BackgroundTransparency = 0.58
    }, 0.1)
    tween(closeIcon, {
        Rotation = 135
    }, 0.14)
    window:SetVisible(false)
end)

window:_track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == window.ToggleKey then
        window:Toggle()
    end
end))

    root.Visible = false
    window:_updateResponsiveScale(false)

    local camera = Workspace.CurrentCamera
    if camera then
    window:_track(camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        window:_updateResponsiveScale(true)
        window.Root.Position = clampToViewport(
            window.Root,
            window.Root.Position,
            window.IsMobile and 12 or 16,
            window.Minimized and window.MinimizedSize or window.FullSize
        )

        if window.ToggleButton then
            window.ToggleButton.Position = clampToViewport(window.ToggleButton, window.ToggleButton.Position, 10)
        end
    end))
end

    if config.AutoLoad == true then
        window:LoadConfig(window.ActiveConfig)
    end

    if config.LoadingIntro ~= false then
        if window.ToggleButton then
            window.ToggleButton.Visible = false
            window.ToggleButton.BackgroundTransparency = 1
        end

        window:_playLoadingIntro(config)
    else
        window:_captureFadeState()
        window:_dissolveVisible(true)
    end

    return window
end

