local DEFAULT_THEME = {
    Background = Color3.fromRGB(16, 17, 17),
    Panel = Color3.fromRGB(23, 24, 23),
    Surface = Color3.fromRGB(31, 32, 30),
    SurfaceHover = Color3.fromRGB(39, 41, 38),
    SurfacePress = Color3.fromRGB(45, 47, 43),
    Accent = Color3.fromRGB(112, 235, 180),
    AccentSoft = Color3.fromRGB(57, 92, 76),
    AccentWarm = Color3.fromRGB(255, 190, 104),
    Text = Color3.fromRGB(245, 247, 242),
    Muted = Color3.fromRGB(154, 160, 150),
    Border = Color3.fromRGB(65, 69, 62),
    Shadow = Color3.fromRGB(0, 0, 0)
}

local function cloneTheme(theme)
    local result = {}

    for key, value in pairs(DEFAULT_THEME) do
        result[key] = value
    end

    if type(theme) == "table" then
        for key, value in pairs(theme) do
            result[key] = value
        end
    end

    return result
end

local function hexToColor(hex)
    if type(hex) ~= "string" then
        return nil
    end

    hex = hex:gsub("#", "")
    if #hex ~= 6 then
        return nil
    end

    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)

    if not r or not g or not b then
        return nil
    end

    return Color3.fromRGB(r, g, b)
end

local function resolveColor(value, fallback)
    if typeof(value) == "Color3" then
        return value
    end

    return hexToColor(value) or fallback
end

local function toHex(color)
    local r = math.clamp(math.floor(color.R * 255 + 0.5), 0, 255)
    local g = math.clamp(math.floor(color.G * 255 + 0.5), 0, 255)
    local b = math.clamp(math.floor(color.B * 255 + 0.5), 0, 255)

    return string.format("#%02X%02X%02X", r, g, b)
end

local function asset(value)
    if type(value) == "number" then
        return "rbxassetid://" .. tostring(value)
    end

    if type(value) ~= "string" or value == "" then
        return ""
    end

    if value:match("^rbxassetid://") then
        return value
    end

    if value:match("^%d+$") then
        return "rbxassetid://" .. value
    end

    return value
end

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    task.spawn(function(...)
        local ok, err = pcall(callback, ...)
        if not ok then
            warn("[Axis Studios UI] Callback error:", err)
        end
    end, ...)
end

local function create(className, props, children)
    local object = Instance.new(className)

    for key, value in pairs(props or {}) do
        object[key] = value
    end

    for _, child in ipairs(children or {}) do
        child.Parent = object
    end

    return object
end

local function corner(radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius)
    })
end

local function stroke(color, transparency, thickness)
    return create("UIStroke", {
        Color = color,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })
end

local function padding(left, top, right, bottom)
    return create("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0)
    })
end

local function tween(instance, props, duration)
    local ok, result = pcall(function()
        local info = TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        local activeTween = TweenService:Create(instance, info, props)
        activeTween:Play()
        return activeTween
    end)

    if ok then
        return result
    end

    for key, value in pairs(props) do
        instance[key] = value
    end

    return nil
end

local function roundTo(value, precision)
    precision = precision or 0

    if precision <= 0 then
        return math.floor(value + 0.5)
    end

    local multiplier = 10 ^ precision
    return math.floor(value * multiplier + 0.5) / multiplier
end

local function formatNumber(value, precision)
    precision = precision or 0

    if precision <= 0 then
        return tostring(math.floor(value + 0.5))
    end

    return string.format("%." .. tostring(precision) .. "f", value)
end

local function getParent()
    local ok, hui = pcall(function()
        if gethui then
            return gethui()
        end

        return nil
    end)

    if ok and hui then
        return hui
    end

    return LocalPlayer:WaitForChild("PlayerGui")
end

local function makeDraggable(handle, frame)
    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input ~= dragInput or not dragging then
            return
        end

        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end

local function bindCanvas(scrollFrame, layout)
    local function updateCanvas()
        scrollFrame.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 18)
    end

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
    task.defer(updateCanvas)
end

local function addScalePress(button, target)
    local scale = create("UIScale", {
        Scale = 1
    })
    scale.Parent = target or button

    button.MouseButton1Down:Connect(function()
        tween(scale, { Scale = 0.985 }, 0.08)
    end)

    button.MouseButton1Up:Connect(function()
        tween(scale, { Scale = 1 }, 0.12)
    end)

    button.MouseLeave:Connect(function()
        tween(scale, { Scale = 1 }, 0.12)
    end)
end

local function resolveKeyCode(value, fallback)
    if typeof(value) == "EnumItem" then
        return value
    end

    if type(value) == "string" then
        local ok, keyCode = pcall(function()
            return Enum.KeyCode[value]
        end)

        if ok and keyCode then
            return keyCode
        end
    end

    return fallback or Enum.KeyCode.RightShift
end

function WindowClass:_track(connection)
    table.insert(self.Connections, connection)
    return connection
end

function WindowClass:_accent(instance, property)
    table.insert(self.AccentTargets, {
        Instance = instance,
        Property = property
    })

    instance[property] = self.Theme.Accent
end

function WindowClass:SetAccent(color)
    color = resolveColor(color, self.Theme.Accent)
    self.Theme.Accent = color

    for _, target in ipairs(self.AccentTargets) do
        if target.Instance and target.Instance.Parent then
            tween(target.Instance, {
                [target.Property] = color
            }, 0.16)
        end
    end
end

function WindowClass:SetTitle(text)
    self.Title = tostring(text or self.Title)
    self.TitleLabel.Text = self.Title
end

function WindowClass:SetSubtitle(text)
    self.Subtitle = tostring(text or "")
    self.SubtitleLabel.Text = self.Subtitle
end

function WindowClass:SetVisible(state)
    self.Visible = state and true or false
    tween(self.RootScale, { Scale = self.Visible and 1 or 0.94 }, 0.16)
    tween(self.Root, {
        BackgroundTransparency = self.Visible and 0 or 1
    }, 0.16)

    task.delay(self.Visible and 0 or 0.16, function()
        self.Root.Visible = self.Visible
    end)

    if self.Visible then
        self.Root.Visible = true
    end
end

function WindowClass:Toggle()
    self:SetVisible(not self.Visible)
end

function WindowClass:Destroy()
    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    if self.Gui then
        self.Gui:Destroy()
    end
end

function WindowClass:CreateTab(config)
    config = type(config) == "table" and config or { Name = tostring(config or "Tab") }

    local tab = setmetatable({
        Window = self,
        Name = config.Name or config.Title or "Tab",
        Groups = {}
    }, TabClass)

    local button = create("TextButton", {
        Name = tab.Name .. "TabButton",
        BackgroundColor3 = self.Theme.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.new(1, 0, 0, 42),
        Parent = self.TabList
    }, {
        corner(12)
    })

    local indicator = create("Frame", {
        Name = "Indicator",
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 6, 0.5, 0),
        Size = UDim2.fromOffset(0, 18),
        Parent = button
    }, {
        corner(8)
    })

    self:_accent(indicator, "BackgroundColor3")

    local iconId = asset(config.Icon or config.Image or config.AssetId)
    local labelX = iconId ~= "" and 42 or 16

    if iconId ~= "" then
        create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            Image = iconId,
            ImageColor3 = self.Theme.Muted,
            Position = UDim2.fromOffset(18, 11),
            Size = UDim2.fromOffset(20, 20),
            Parent = button
        })
    end

    local label = create("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = tab.Name,
        TextColor3 = self.Theme.Muted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.fromOffset(labelX, 0),
        Size = UDim2.new(1, -labelX - 12, 1, 0),
        Parent = button
    })

    local page = create("ScrollingFrame", {
        Name = tab.Name .. "Page",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        CanvasSize = UDim2.fromOffset(0, 0),
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.Theme.Border,
        Position = UDim2.fromOffset(168, 68),
        Size = UDim2.new(1, -184, 1, -84),
        Visible = false,
        Parent = self.Root
    })

    local pagePadding = padding(2, 2, 10, 6)
    pagePadding.Parent = page

    local layout = create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
        Parent = page
    })

    bindCanvas(page, layout)

    tab.Button = button
    tab.Label = label
    tab.Indicator = indicator
    tab.Page = page

    button.MouseEnter:Connect(function()
        if self.SelectedTab ~= tab then
            tween(button, {
                BackgroundTransparency = 0.35,
                BackgroundColor3 = self.Theme.Surface
            }, 0.14)
        end
    end)

    button.MouseLeave:Connect(function()
        if self.SelectedTab ~= tab then
            tween(button, {
                BackgroundTransparency = 1
            }, 0.14)
        end
    end)

    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)

    if not self.SelectedTab then
        self:SelectTab(tab)
    end

    return tab
end

function WindowClass:SelectTab(tab)
    self.SelectedTab = tab

    for _, current in ipairs(self.Tabs) do
        local selected = current == tab
        current.Page.Visible = selected

        tween(current.Button, {
            BackgroundTransparency = selected and 0 or 1,
            BackgroundColor3 = selected and self.Theme.SurfaceHover or self.Theme.Surface
        }, 0.18)

        tween(current.Label, {
            TextColor3 = selected and self.Theme.Text or self.Theme.Muted
        }, 0.18)

        tween(current.Indicator, {
            Size = UDim2.fromOffset(selected and 4 or 0, 18)
        }, 0.18)

        local icon = current.Button:FindFirstChild("Icon")
        if icon then
            tween(icon, {
                ImageColor3 = selected and self.Theme.Accent or self.Theme.Muted
            }, 0.18)
        end
    end
end

