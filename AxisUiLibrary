})

local selectedText = create("TextLabel", {
    BackgroundTransparency = 1,
    Font = Enum.Font.GothamMedium,
    Text = "Select",
    TextColor3 = self.Window.Theme.Muted,
    TextSize = 12,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextTruncate = Enum.TextTruncate.AtEnd,
    Position = UDim2.fromOffset(10, 0),
    Size = UDim2.new(1, -38, 1, 0),
    Parent = selector
})

local caret = create("TextLabel", {
    BackgroundTransparency = 1,
    Font = Enum.Font.GothamBold,
    Text = "v",
    TextColor3 = self.Window.Theme.Muted,
    TextSize = 12,
    TextXAlignment = Enum.TextXAlignment.Center,
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -8, 0, 0),
    Size = UDim2.fromOffset(18, 24),
    Parent = selector
})

local refresh = create("TextButton", {
    BackgroundColor3 = self.Window.Theme.Panel,
    BorderSizePixel = 0,
    AutoButtonColor = false,
    Font = Enum.Font.GothamBold,
    Text = "R",
    TextColor3 = self.Window.Theme.Accent,
    TextSize = 12,
    Position = UDim2.new(1, -38, 0, 31),
    Size = UDim2.fromOffset(24, 24),
    Parent = row
}, {
    corner(9),
    stroke(self.Window.Theme.Border, 0.55, 1)
})

self.Window:_accent(refresh, "TextColor3")

local menu = create("ScrollingFrame", {
    BackgroundColor3 = self.Window.Theme.Panel,
    BorderSizePixel = 0,
    CanvasSize = UDim2.fromOffset(0, 0),
    ClipsDescendants = true,
    ScrollBarThickness = 2,
    ScrollBarImageColor3 = self.Window.Theme.Border,
    Position = UDim2.fromOffset(14, 62),
    Size = UDim2.new(1, -28, 0, 0),
    Visible = false,
    Parent = row
}, {
    corner(10),
    stroke(self.Window.Theme.Border, 0.5, 1)
})

local menuLayout = create("UIListLayout", {
    FillDirection = Enum.FillDirection.Vertical,
    HorizontalAlignment = Enum.HorizontalAlignment.Center,
    SortOrder = Enum.SortOrder.LayoutOrder,
    Padding = UDim.new(0, 4),
    Parent = menu
})

local menuPadding = padding(5, 5, 5, 5)
menuPadding.Parent = menu

local object = {
    Instance = row,
    Options = options,
    Value = selected,
    Multi = multi
}

local function hasOption(value)
    return table.find(options, value) ~= nil
end

local function addOption(value)
    value = tostring(value)

    if not hasOption(value) then
        table.insert(options, value)
    end

    return value
end

local function selectedList()
    local list = {}

    for _, option in ipairs(options) do
        if selectedSet[option] then
            table.insert(list, option)
        end
    end

    return list
end

local function isSelected(option)
    if multi then
        return selectedSet[option] == true
    end

    return option == selected
end

local function currentValue()
    if multi then
        return selectedList()
    end

    return selected
end

local function selectedCount()
    if not multi then
        return selected and 1 or 0
    end

    local count = 0

    for _ in pairs(selectedSet) do
        count = count + 1
    end

    return count
end

local function menuHeight()
    return math.min(#options, maxVisible) * optionHeight + 10
end

local function updateSelectedText()
    local count = selectedCount()

    if multi then
        local list = selectedList()

        if #list == 0 then
            selectedText.Text = config.Placeholder or "Select"
        elseif #list <= 2 then
            selectedText.Text = table.concat(list, ", ")
        else
            selectedText.Text = list[1] .. ", " .. list[2] .. " +" .. tostring(#list - 2)
        end
    else
        selectedText.Text = selected or (config.Placeholder or "Select")
    end

    selectedText.TextColor3 = count > 0 and self.Window.Theme.Text or self.Window.Theme.Muted
    object.Value = currentValue()
end

local function setOpen(state)
    open = state and true or false
    caret.Text = open and "^" or "v"

    if open then
        menu.Visible = true
    end

    local height = open and menuHeight() or 0

    tween(menu, {
        Size = UDim2.new(1, -28, 0, height)
    }, 0.18)

    tween(row, {
        Size = UDim2.new(1, 0, 0, collapsedHeight + (open and height + 10 or 0))
    }, 0.18)

    if not open then
        task.delay(0.18, function()
            if not open then
                menu.Visible = false
            end
        end)
    end
end

local function rebuild()
    for _, child in ipairs(menu:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, option in ipairs(options) do
        local optionSelected = isSelected(option)

        local optionButton = create("TextButton", {
            BackgroundColor3 = optionSelected and self.Window.Theme.SurfaceHover or self.Window.Theme.Surface,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Font = Enum.Font.GothamMedium,
            Text = multi and ((optionSelected and "[x] " or "[ ] ") .. option) or option,
            TextColor3 = optionSelected and self.Window.Theme.Text or self.Window.Theme.Muted,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(1, 0, 0, optionHeight - 4),
            Parent = menu
        }, {
            corner(8),
            padding(10, 0, 10, 0)
        })

        optionButton.MouseEnter:Connect(function()
            tween(optionButton, {
                BackgroundColor3 = self.Window.Theme.SurfaceHover,
                TextColor3 = self.Window.Theme.Text
            }, 0.12)
        end)

        optionButton.MouseLeave:Connect(function()
            tween(optionButton, {
                BackgroundColor3 = isSelected(option) and self.Window.Theme.SurfaceHover or self.Window.Theme.Surface,
                TextColor3 = isSelected(option) and self.Window.Theme.Text or self.Window.Theme.Muted
            }, 0.12)
        end)

        optionButton.MouseButton1Click:Connect(function()
            if multi then
                if selectedSet[option] then
                    selectedSet[option] = nil
                else
                    selectedSet[option] = true
                end
            else
                selected = option
            end

            updateSelectedText()
            rebuild()

            if not multi then
                setOpen(false)
            end

            local value = currentValue()
            safeCall(config.Callback, value)
            safeCall(config.Changed, value)
            self.Window:_queueAutoSave()
        end)
    end

    menu.CanvasSize = UDim2.fromOffset(0, menuLayout.AbsoluteContentSize.Y + 10)

    if open then
        row.Size = UDim2.new(1, 0, 0, collapsedHeight + menuHeight() + 10)
        menu.Size = UDim2.new(1, -28, 0, menuHeight())
    end
end

function object:SetOptions(newOptions, keepValue)
    local oldSelection = multi and selectedList() or selected
    options = {}

    for _, option in ipairs(newOptions or {}) do
        table.insert(options, tostring(option))
    end

    self.Options = options

    if multi then
        selectedSet = {}

        if keepValue and type(oldSelection) == "table" then
            for _, option in ipairs(oldSelection) do
                option = tostring(option)

                if hasOption(option) then
                    selectedSet[option] = true
                end
            end
        end
    elseif not keepValue or (selected and not table.find(options, selected)) then
        selected = options[1]
    end

    updateSelectedText()
    rebuild()
end

function object:Refresh(newOptions)
    if type(newOptions) == "table" then
        self:SetOptions(newOptions, true)
        safeCall(config.OnRefresh, options, self)
        return
    end

    local refreshSource = config.Refresh or config.RefreshCallback or config.GetOptions

    if type(refreshSource) == "function" then
        local ok, result = pcall(refreshSource, options, self)
        if ok and type(result) == "table" then
            self:SetOptions(result, true)
        elseif not ok then
            warn("[Axis Studios UI] Dropdown refresh error:", result)
        end
    else
        rebuild()
    end

    safeCall(config.OnRefresh, options, self)
end

function object:SetValue(newValue, noCallback)
    if multi then
        selectedSet = {}

        if type(newValue) == "table" then
            for _, option in ipairs(newValue) do
                option = addOption(option)
                selectedSet[option] = true
            end
        elseif newValue ~= nil then
            local option = addOption(newValue)
            selectedSet[option] = true
        end
    else
        selected = newValue ~= nil and addOption(newValue) or nil
    end

    updateSelectedText()
    rebuild()

    if not noCallback then
        local value = currentValue()
        safeCall(config.Callback, value)
        safeCall(config.Changed, value)
        self.Window:_queueAutoSave()
    end
end

function object:UpdateSelection(newValue)
    self:SetValue(newValue)
end

function object:GetValue()
    return currentValue()
end

selector.MouseButton1Click:Connect(function()
    setOpen(not open)
end)

refresh.MouseButton1Click:Connect(function()
    tween(refresh, {
        Rotation = refresh.Rotation + 180
    }, 0.18)
    object:Refresh()
end)

if multi then
    local initial = config.Default or config.Value

    if type(initial) == "table" then
        for _, option in ipairs(initial) do
            option = addOption(option)
            selectedSet[option] = true
        end
    elseif initial ~= nil then
        local option = addOption(initial)
        selectedSet[option] = true
    end
elseif type(config.Default) == "number" then
    selected = options[config.Default] or options[1]
else
    selected = config.Default or config.Value or options[1]
end

if selected and not multi then
    selected = tostring(selected)
end

