        Size = UDim2.new(1, -58, 0, 24),
        Parent = panel
    })

    local rainbowButton = create("TextButton", {
        BackgroundColor3 = Color3.fromRGB(47, 50, 45),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 68),
        Size = UDim2.fromOffset(46, 24),
        Parent = panel
    }, {
        corner(24)
    })

    local rainbowKnob = create("Frame", {
        BackgroundColor3 = self.Window.Theme.Muted,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(18, 18),
        Parent = rainbowButton
    }, {
        corner(18)
    })

    local object = {
        Instance = row,
        Color = color,
        Rainbow = false
    }

    local function setOpen(state)
        open = state and true or false
        expand.Text = open and "^" or "v"
        tween(row, {
            Size = UDim2.new(1, 0, 0, open and expandedHeight or collapsedHeight)
        }, 0.18)
    end

    local function applyColor(fire)
        color = Color3.fromHSV(hue, 1, brightness)
        object.Color = color
        swatch.BackgroundColor3 = color
        hexLabel.Text = toHex(color)
        hueKnob.Position = UDim2.fromScale(hue, 0.5)
        brightnessFill.Size = UDim2.fromScale(brightness, 1)
        brightnessKnob.Position = UDim2.fromScale(brightness, 0.5)

        if fire then
            safeCall(config.Callback, color, object)
            safeCall(config.Changed, color, object)
        end
    end

    local function setHueFromInput(input)
        hue = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / math.max(hueTrack.AbsoluteSize.X, 1), 0, 1)
        applyColor(true)
    end

    local function setBrightnessFromInput(input)
        brightness = math.clamp((input.Position.X - brightnessTrack.AbsolutePosition.X) / math.max(brightnessTrack.AbsoluteSize.X, 1), 0, 1)
        applyColor(true)
    end

    function object:SetColor(newColor, noCallback)
        newColor = resolveColor(newColor, color)
        local h, _, v = newColor:ToHSV()
        hue = h
        brightness = v
        applyColor(not noCallback)
    end

    function object:GetColor()
        return color
    end

    function object:SetRainbow(state)
        rainbow = state and true or false
        object.Rainbow = rainbow

        tween(rainbowButton, {
            BackgroundColor3 = rainbow and window.Theme.AccentSoft or Color3.fromRGB(47, 50, 45)
        }, 0.15)

        tween(rainbowKnob, {
            Position = rainbow and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = rainbow and window.Theme.Accent or window.Theme.Muted
        }, 0.15)

        if rainbowConnection then
            rainbowConnection:Disconnect()
            rainbowConnection = nil
        end

        if rainbow then
            rainbowConnection = window:_track(RunService.RenderStepped:Connect(function(dt)
                hue = (hue + dt * (config.RainbowSpeed or 0.15)) % 1
                applyColor(true)
            end))
        end
    end

    expand.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    swatch.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    rainbowButton.MouseButton1Click:Connect(function()
        object:SetRainbow(not rainbow)
    end)

    hueTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            setHueFromInput(input)
        end
    end)

    brightnessTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingBrightness = true
            setBrightnessFromInput(input)
        end
    end)

    self.Window:_track(UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if draggingHue then
            setHueFromInput(input)
        elseif draggingBrightness then
            setBrightnessFromInput(input)
        end
    end))

    self.Window:_track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = false
            draggingBrightness = false
        end
    end))

    applyColor(false)

    if config.Rainbow == true or config.DefaultRainbow == true then
        object:SetRainbow(true)
    end

    return object
end

