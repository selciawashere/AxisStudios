        ImageColor3 = theme.Accent,
        Position = UDim2.fromOffset(9, 9),
        Size = UDim2.new(1, -18, 1, -18),
        ZIndex = 1001,
        Parent = toggleButton
    })

    local pressed = false
    local moved = false
    local pressPosition = nil

    toggleButton.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        pressed = true
        moved = false
        pressPosition = input.Position
    end)

    toggleButton.InputChanged:Connect(function(input)
        if not pressed or not pressPosition then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if (input.Position - pressPosition).Magnitude > 8 then
            moved = true
        end
    end)

    toggleButton.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local shouldToggle = pressed and not moved
        pressed = false
        moved = false
        pressPosition = nil

        if shouldToggle then
            window:Toggle()
        end
    end)

    makeDraggable(toggleButton, toggleButton, window, true)
    addScalePress(toggleButton, toggleButton)

    window.ToggleButton = toggleButton
    window.ToggleIcon = toggleIcon
end

