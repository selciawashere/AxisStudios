    end)

    return {
        Instance = row,
        SetText = function(_, text)
            action.Text = tostring(text or "")
        end
    }
end

function GroupClass:Toggle(config)
    config = type(config) == "table" and config or {}

    local value = config.Default == true or config.Value == true
    local row = self:_row(54)

    local button = create("TextButton", {
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.fromScale(1, 1),
        Parent = row
    })

    local title = create("TextLabel", {
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = config.Name or config.Title or "Toggle",
        TextColor3 = self.Window.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -86, 1, 0),
        Parent = button
    })

    local switch = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = Color3.fromRGB(47, 50, 45),
        BorderSizePixel = 0,
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(46, 24),
        Parent = button
    }, {
        corner(24)
    })

    local knob = create("Frame", {
        BackgroundColor3 = self.Window.Theme.Muted,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(18, 18),
        Parent = switch
    }, {
        corner(18)
    })

    local object = {
        Instance = row,
        Value = value
    }

    local function render(fire)
        object.Value = value

        tween(row, {
            BackgroundColor3 = value and self.Window.Theme.SurfaceHover or self.Window.Theme.Surface
        }, 0.15)

        tween(switch, {
            BackgroundColor3 = value and self.Window.Theme.AccentSoft or Color3.fromRGB(47, 50, 45)
        }, 0.15)

        tween(knob, {
            Position = value and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = value and self.Window.Theme.Accent or self.Window.Theme.Muted
        }, 0.15)

        if fire then
            safeCall(config.Callback, value)
            safeCall(config.Changed, value)
        end
    end

    function object:SetValue(newValue, noCallback)
        value = newValue and true or false
        render(not noCallback)
    end

    function object:SetLabel(text)
        title.Text = tostring(text or "")
    end

    function object:GetValue()
        return value
    end

    button.MouseEnter:Connect(function()
        if not value then
            tween(row, {
                BackgroundColor3 = self.Window.Theme.SurfaceHover
            }, 0.14)
        end
    end)

    button.MouseLeave:Connect(function()
        if not value then
            tween(row, {
                BackgroundColor3 = self.Window.Theme.Surface
            }, 0.14)
        end
    end)

    button.MouseButton1Click:Connect(function()
        value = not value
        render(true)
    end)

    render(false)
    return object
end

