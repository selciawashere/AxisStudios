    local rootScale = create("UIScale", {
        Scale = 1,
        Parent = root
    })

    create("Frame", {
        Name = "Shadow",
        BackgroundColor3 = theme.Shadow,
        BackgroundTransparency = 0.72,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.new(1, -24, 1, -24),
        ZIndex = 0,
        Parent = root
    }, {
        corner(18)
    })

    local topBar = create("Frame", {
        Name = "TopBar",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 58),
        Parent = root
    })

    local logoHolder = create("Frame", {
        Name = "LogoHolder",
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(16, 13),
        Size = UDim2.fromOffset(32, 32),
        Parent = topBar
    }, {
        corner(11),
        stroke(theme.Border, 0.45, 1)
    })

    create("ImageLabel", {
        Name = "Logo",
        BackgroundTransparency = 1,
        Image = asset(config.Icon or config.Logo or config.AssetId or DEFAULT_LOGO),
        ImageColor3 = config.LogoColor and resolveColor(config.LogoColor, theme.Text) or Color3.fromRGB(255, 255, 255),
        Position = UDim2.fromOffset(6, 6),
        Size = UDim2.fromOffset(20, 20),
        Parent = logoHolder
    })

    local titleLabel = create("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = theme.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.fromOffset(60, 10),
        Size = UDim2.new(1, -118, 0, 24),
        Parent = topBar
    })

    local subtitleLabel = create("TextLabel", {
        Name = "Subtitle",
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = subtitle,
        TextColor3 = theme.Muted,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.fromOffset(60, 32),
        Size = UDim2.new(1, -118, 0, 18),
        Parent = topBar
    })

    local close = create("TextButton", {
        Name = "Close",
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Enum.Font.GothamBold,
        Text = "x",
        TextColor3 = theme.Muted,
        TextSize = 13,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -16, 0, 17),
        Size = UDim2.fromOffset(26, 26),
        Parent = topBar
    }, {
        corner(10),
        stroke(theme.Border, 0.55, 1)
    })

    local tabRail = create("Frame", {
        Name = "TabRail",
        BackgroundColor3 = theme.Panel,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(12, 66),
        Size = UDim2.new(0, 144, 1, -78),
        Parent = root
    }, {
        corner(16),
        stroke(theme.Border, 0.46, 1),
        padding(8, 8, 8, 8)
    })

    local tabList = create("Frame", {
        Name = "TabList",
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        Parent = tabRail
    })

    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = tabList
    })

    local window = setmetatable({
        Gui = gui,
        Root = root,
        RootScale = rootScale,
        TabList = tabList,
        TopBar = topBar,
        Title = title,
        Subtitle = subtitle,
        TitleLabel = titleLabel,
        SubtitleLabel = subtitleLabel,
        Theme = theme,
        Tabs = {},
        Connections = {},
        AccentTargets = {},
        Visible = true,
        ToggleKey = resolveKeyCode(config.ToggleKey or config.Keybind, Enum.KeyCode.RightControl)
    }, WindowClass)

    makeDraggable(topBar, root)
    addScalePress(close, close)

    close.MouseEnter:Connect(function()
        tween(close, {
            BackgroundColor3 = theme.SurfaceHover,
            TextColor3 = theme.Text
        }, 0.12)
    end)

    close.MouseLeave:Connect(function()
        tween(close, {
            BackgroundColor3 = theme.Surface,
            TextColor3 = theme.Muted
        }, 0.12)
    end)

    close.MouseButton1Click:Connect(function()
        window:SetVisible(false)
    end)

    window:_track(UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.KeyCode == window.ToggleKey then
            window:Toggle()
        end
    end))

    root.BackgroundTransparency = 1
    rootScale.Scale = 0.96
    tween(root, { BackgroundTransparency = 0 }, 0.22)
    tween(rootScale, { Scale = 1 }, 0.22)

    return window
end

Axis.Window = Axis.CreateWindow
Axis.Create = Axis.CreateWindow

function Axis:Demo()
    local window = self:CreateWindow({
        Title = "Axis Studios",
        Subtitle = "Live smooth UI library",
        Icon = DEFAULT_LOGO
    })

    local elements = window:Tab({
        Name = "Elements",
        Icon = "10734950309"
    })

    local main = elements:Group({
        Name = "Live Controls"
    })

    local liveLabel = main:Label({
        Text = "Ready",
        Color = DEFAULT_THEME.Muted
    })

    main:Button({
        Name = "Button",
        Text = "Click",
        Callback = function()
            liveLabel:SetText("Button clicked at " .. os.date("%X"))
        end
    })

    main:Toggle({
        Name = "Live Toggle",
        Default = false,
        Callback = function(enabled)
            liveLabel:SetText("Toggle: " .. (enabled and "On" or "Off"))
        end
    })

    main:Keybind({
        Name = "Action Keybind",
        Key = Enum.KeyCode.F,
        Callback = function(key)
            liveLabel:SetText("Pressed keybind: " .. key.Name)
        end,
        OnBinded = function(key)
            liveLabel:SetText("Keybind changed to: " .. key.Name)
        end
    })

    main:Slider({
        Name = "Decimal Slider",
        Min = 0,
        Max = 10,
        Default = 2.5,
        Decimals = 2,
        Callback = function(value)
            liveLabel:SetText("Slider value: " .. formatNumber(value, 2))
        end
    })

    local dropdownOptions = { "Alpha", "Beta", "Gamma" }

    main:Dropdown({
        Name = "Refreshable Dropdown",
        Options = dropdownOptions,
        Default = "Alpha",
        Refresh = function()
            local nextOption = "Live " .. tostring(#dropdownOptions + 1)
            table.insert(dropdownOptions, nextOption)
            return dropdownOptions
        end,
        Callback = function(value)
            liveLabel:SetText("Dropdown selected: " .. tostring(value))
        end
    })

    main:ColorPicker({
        Name = "Primary Color",
        Default = DEFAULT_THEME.Accent,
        Rainbow = false,
        Callback = function(color)
            window:SetAccent(color)
            liveLabel:SetText("Primary color: " .. toHex(color))
        end
    })

    main:ColorPicker({
        Name = "Second Color",
        Default = DEFAULT_THEME.AccentWarm,
        Callback = function(color)
            liveLabel:SetColor(color)
            liveLabel:SetText("Second color: " .. toHex(color))
        end
    })

    local layoutTab = window:Tab({
        Name = "Tabs",
        Icon = "10734950309"
    })

    local group = layoutTab:Group({
        Name = "Tab And Group"
    })

    group:Label({
        Text = "Layout status: Active"
    })

    group:Button({
        Name = "Select Elements",
        Text = "Open",
        Callback = function()
            window:SelectTab(elements)
        end
    })

    return window
end

return Axis
