        Name = config.ConfigGroupName or "Configuration"
    })

local configStatus = configGroup:Label({
    Text = "Config: " .. tostring(self.ActiveConfig or "default")
})

local autoSaveToggle
local configDropdown
local function configOptions()
    local list = self:ListConfigs()

    for _, name in ipairs(config.Slots or { "default", "slot-1", "slot-2", "slot-3" }) do
        if not table.find(list, name) then
            table.insert(list, name)
        end
    end

    table.sort(list)
    return list
end

autoSaveToggle = configGroup:Toggle({
    Name = "Auto Save",
    Default = self.AutoSave == true,
    Save = false,
    Callback = function(enabled)
        self:SetAutoSave(enabled)
        configStatus:SetText("Auto Save: " .. (enabled and "On" or "Off"))
    end
})

configDropdown = configGroup:Dropdown({
    Name = "Saved Configs",
    Options = configOptions(),
    Default = self.ActiveConfig or "default",
    Save = false,
    Refresh = function()
        return configOptions()
    end,
    Callback = function(value)
        self.ActiveConfig = value or "default"
        configStatus:SetText("Config: " .. tostring(self.ActiveConfig))
    end
})

configGroup:Button({
    Name = "Save Config",
    Text = "Save",
    Callback = function()
        self:SaveConfig(configDropdown:GetValue() or self.ActiveConfig or "default")
        configDropdown:Refresh(configOptions())
        configStatus:SetText("Saved: " .. tostring(self.ActiveConfig))
    end
})

configGroup:Button({
    Name = "Load Config",
    Text = "Load",
    Callback = function()
        local target = configDropdown:GetValue() or self.ActiveConfig or "default"
        local loaded = self:LoadConfig(target)

        autoSaveToggle:SetValue(self.AutoSave, true)
        themeDropdown:SetValue(self.ThemeName or "Axis", true)
        configStatus:SetText((loaded and "Loaded: " or "Missing: ") .. tostring(target))
    end
})

configGroup:Button({
    Name = "Refresh Configs",
    Text = "Refresh",
    Callback = function()
        configDropdown:Refresh(configOptions())
        configStatus:SetText("Config list refreshed")
    end
})

return tab
end

