function WindowClass:SetTheme(theme, noSave)
local previous = cloneTheme(self.Theme)
local nextTheme, themeName = resolveThemeSpec(theme, self.ThemeName)

local function remap(color)
    for token, previousColor in pairs(previous) do
        if nextTheme[token] and colorClose(color, previousColor) then
            return nextTheme[token]
        end
    end

    return color
end

self.Theme = nextTheme
self.ThemeName = themeName

for _, object in ipairs(self.Root:GetDescendants()) do
    if object:IsA("GuiObject") then
        if typeof(object.BackgroundColor3) == "Color3" then
            object.BackgroundColor3 = remap(object.BackgroundColor3)
        end

        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            object.TextColor3 = remap(object.TextColor3)
        end

        if object:IsA("ImageLabel") or object:IsA("ImageButton") then
            object.ImageColor3 = remap(object.ImageColor3)
        end

        if object:IsA("ScrollingFrame") then
            object.ScrollBarImageColor3 = remap(object.ScrollBarImageColor3)
        end
    elseif object:IsA("UIStroke") then
        object.Color = remap(object.Color)
    end
end

self.Root.BackgroundColor3 = nextTheme.Background
self:SetAccent(nextTheme.Accent)

if self.ToggleButton then
    self.ToggleButton.BackgroundColor3 = self.Visible and nextTheme.AccentSoft or nextTheme.Panel
end

if self.ToggleIcon then
    self.ToggleIcon.ImageColor3 = self.Visible and nextTheme.Accent or nextTheme.Text
end

if not noSave then
    self:_queueAutoSave()
end
end

