    TextSize = 12,
    Position = UDim2.new(1, -14, 0.5, 0),
    Size = UDim2.fromOffset(82, 30),
    Parent = row
}, {
    corner(10),
    stroke(self.Window.Theme.Border, 0.48, 1)
})

local object = {
    Instance = row,
    Key = currentKey
}

local function render()
    object.Key = currentKey
    keyBox.Text = listening and "..." or currentKey.Name

    tween(keyBox, {
        BackgroundColor3 = listening and self.Window.Theme.AccentSoft or self.Window.Theme.Panel,
        TextColor3 = listening and self.Window.Theme.Accent or self.Window.Theme.Text
    }, 0.14)
end

function object:SetKey(key, noCallback)
    currentKey = resolveKeyCode(key, currentKey)
    listening = false
    render()

    if not noCallback then
        safeCall(config.Changed, currentKey)
        safeCall(config.OnBinded or config.OnBound, currentKey)
        self.Window:_queueAutoSave()
    end
end

function object:SetLabel(text)
    title.Text = tostring(text or "")
end

function object:GetKey()
    return currentKey
end

button.MouseEnter:Connect(function()
    tween(row, {
        BackgroundColor3 = self.Window.Theme.SurfaceHover
    }, 0.14)
end)

button.MouseLeave:Connect(function()
    tween(row, {
        BackgroundColor3 = self.Window.Theme.Surface
    }, 0.14)
end)

keyBox.MouseButton1Click:Connect(function()
    listening = true
    render()
end)

self.Window:_track(UserInputService.InputBegan:Connect(function(input, processed)
    if listening then
        if input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
            currentKey = input.KeyCode
            listening = false
            render()
            safeCall(config.Changed, currentKey)
            safeCall(config.OnBinded or config.OnBound, currentKey)
            self.Window:_queueAutoSave()
        end

        return
    end

    if processed then
        return
    end

    if input.KeyCode == currentKey then
        safeCall(config.Callback, currentKey)
    end
end))

render()
return self.Window:_registerControl(config, "Keybind", object)
end

