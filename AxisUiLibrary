function GroupClass:Slider(config)
    config = type(config) == "table" and config or {}

    local min = tonumber(config.Min or config.Minimum or 0) or 0
    local max = tonumber(config.Max or config.Maximum or 100) or 100
    local precision = tonumber(config.Decimals or config.Precision or config.Rounding or 0) or 0
    local step = tonumber(config.Step)

    if max < min then
        min, max = max, min
    end

    local value = tonumber(config.Default or config.Value or min) or min
    local dragging = false

    local row = self:_row(76)

    local title = create("TextLabel", {
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = config.Name or config.Title or "Slider",
        TextColor3 = self.Window.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.fromOffset(14, 9),
        Size = UDim2.new(1, -112, 0, 20),
        Parent = row
    })

    local valueLabel = create("TextLabel", {
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "",
        TextColor3 = self.Window.Theme.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Position = UDim2.new(1, -92, 0, 9),
        Size = UDim2.fromOffset(78, 20),
        Parent = row
    })

    self.Window:_accent(valueLabel, "TextColor3")

    local track = create("Frame", {
        BackgroundColor3 = Color3.fromRGB(48, 51, 46),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 14, 0, 44),
        Size = UDim2.new(1, -28, 0, 8),
        Parent = row
    }, {
        corner(8)
    })

    local fill = create("Frame", {
        BackgroundColor3 = self.Window.Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(0, 1),
        Parent = track
    }, {
        corner(8)
    })

    self.Window:_accent(fill, "BackgroundColor3")

    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = self.Window.Theme.Text,
        BorderSizePixel = 0,
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(16, 16),
        Parent = track
    }, {
        corner(16),
        stroke(self.Window.Theme.Background, 0, 2)
    })

    local object = {
        Instance = row,
        Value = value,
        Min = min,
        Max = max,
        Precision = precision
    }

    local function snap(inputValue)
        inputValue = math.clamp(inputValue, min, max)

        if step and step > 0 then
            inputValue = min + math.floor(((inputValue - min) / step) + 0.5) * step
        end

        return roundTo(math.clamp(inputValue, min, max), precision)
    end

    local function render(fire)
        local percent = 0

        if max ~= min then
            percent = math.clamp((value - min) / (max - min), 0, 1)
        end

        fill.Size = UDim2.fromScale(percent, 1)
        knob.Position = UDim2.fromScale(percent, 0.5)
        valueLabel.Text = formatNumber(value, precision)
        object.Value = value

        if fire then
            safeCall(config.Callback, value)
            safeCall(config.Changed, value)
        end
    end

    local function setFromInput(input)
        local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        value = snap(min + (max - min) * percent)
        render(true)
    end

    function object:SetValue(newValue, noCallback)
        value = snap(tonumber(newValue) or min)
        render(not noCallback)
    end

    function object:SetLabel(text)
        title.Text = tostring(text or "")
    end

    function object:GetValue()
        return value
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        setFromInput(input)
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    self.Window:_track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            setFromInput(input)
        end
    end))

    self.Window:_track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    render(false)
    return object
end

