        Position = config.ToggleButtonPosition or UDim2.new(0.5, -math.floor(toggleSize / 2), 0, isMobile and 14 or 12),
        Size = UDim2.fromOffset(toggleSize, toggleSize),
        Text = "",
        ZIndex = 1000,
