function WindowClass:_fadeTargets()
local targets = {}
local seen = setmetatable({}, { __mode = "k" })

local function add(instance, property)
    if not instance or not instance.Parent then
        return
    end

    seen[instance] = seen[instance] or {}

    if seen[instance][property] then
        return
    end

    seen[instance][property] = true
    table.insert(targets, {
        Instance = instance,
        Property = property
    })
end

local function scan(instance)
    if instance:IsA("GuiObject") then
        add(instance, "BackgroundTransparency")

        if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
            add(instance, "TextTransparency")
        end

        if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
            add(instance, "ImageTransparency")
        end

        if instance:IsA("ScrollingFrame") then
            add(instance, "ScrollBarImageTransparency")
        end
    elseif instance:IsA("UIStroke") then
        add(instance, "Transparency")
    end
end

scan(self.Root)

for _, child in ipairs(self.Root:GetDescendants()) do
    scan(child)
end

return targets
end

function WindowClass:_captureFadeState()
self.FadeCache = self.FadeCache or setmetatable({}, { __mode = "k" })

for _, target in ipairs(self:_fadeTargets()) do
    local instance = target.Instance
    local property = target.Property
    self.FadeCache[instance] = self.FadeCache[instance] or {}

    if instance[property] ~= nil then
        self.FadeCache[instance][property] = instance[property]
    end
end
end

function WindowClass:_setDissolved()
for _, target in ipairs(self:_fadeTargets()) do
    local instance = target.Instance
    local property = target.Property

    if instance[property] ~= nil then
        instance[property] = 1
    end
end
end

function WindowClass:_dissolveVisible(state, instant)
local visible = state and true or false
local duration = instant and 0.01 or (visible and 0.46 or 0.34)

if visible then
    self.Root.Visible = true
    local fadeTargets = self:_fadeTargets()
    local fallbackFinals = setmetatable({}, { __mode = "k" })

    for _, target in ipairs(fadeTargets) do
        fallbackFinals[target.Instance] = fallbackFinals[target.Instance] or {}
        fallbackFinals[target.Instance][target.Property] = target.Instance[target.Property]
    end

    if not self.FadeCache then
        self:_captureFadeState()
    end

    self:_setDissolved()
    self:_setScaledVisibilityScale(0.965, 0.01)

    task.defer(function()
        for index, target in ipairs(fadeTargets) do
            local instance = target.Instance
            local property = target.Property
            local cached = self.FadeCache and self.FadeCache[instance]
            local fallback = fallbackFinals[instance]
            local finalValue = cached and cached[property] or (fallback and fallback[property]) or 0

            task.delay(math.min(index * 0.0015, 0.07), function()
                if instance and instance.Parent then
                    tween(instance, {
                        [property] = finalValue
                    }, duration)
                end
            end)
        end
    end)
else
    self:_captureFadeState()

    for index, target in ipairs(self:_fadeTargets()) do
        local instance = target.Instance
        local property = target.Property

        task.delay(math.min(index * 0.001, 0.05), function()
            if instance and instance.Parent then
                tween(instance, {
                    [property] = 1
                }, duration)
            end
        end)
    end

    task.delay(duration + 0.08, function()
        if not self.Visible then
            self.Root.Visible = false
        end
    end)
end

self:_setScaledVisibilityScale(visible and 1 or 0.935, duration)
end

function WindowClass:_setScaledVisibilityScale(multiplier, duration)
tween(self.RootScale, {
    Scale = (self.BaseScale or 1) * (multiplier or 1)
}, duration or 0.18)
end

function WindowClass:_updateResponsiveScale(animated)
if self.AutoScale == false then
    self.BaseScale = 1
else
    self.BaseScale = getFitScale(self.FullSize or self.Root.Size, self.IsMobile and 22 or 36)
end

self:_setScaledVisibilityScale(self.Visible and 1 or 0.94, animated and 0.18 or 0.01)
end

function WindowClass:SetVisible(state)
self.Visible = state and true or false
self:_dissolveVisible(self.Visible)

if self.ToggleButton then
    tween(self.ToggleButton, {
        BackgroundColor3 = self.Visible and self.Theme.AccentSoft or self.Theme.Panel
    }, 0.24)
end

if self.ToggleIcon then
    tween(self.ToggleIcon, {
        ImageColor3 = self.Visible and self.Theme.Accent or self.Theme.Text,
        Rotation = self.Visible and 0 or -12
    }, 0.24)
end
end

function WindowClass:Toggle()
self:SetVisible(not self.Visible)
end

function WindowClass:_refreshMinimizeVisual(hovered)
local activeTheme = self.Theme or DEFAULT_THEME
local active = hovered or self.Minimized
local accent = self.MinimizeCustomAccent and self.MinimizeAccent or activeTheme.Accent

if self.MinimizeButton then
    tween(self.MinimizeButton, {
        BackgroundColor3 = hovered and activeTheme.SurfaceHover or (self.Minimized and activeTheme.AccentSoft or activeTheme.Surface),
        BackgroundTransparency = active and 0 or 0.08
    }, 0.2)
end

if self.MinimizeStroke then
    tween(self.MinimizeStroke, {
        Color = active and accent or activeTheme.Border,
        Transparency = active and 0.18 or 0.52,
        Thickness = active and 1.2 or 1
    }, 0.2)
end

if self.MinimizeGlow then
    tween(self.MinimizeGlow, {
        BackgroundColor3 = accent,
        BackgroundTransparency = hovered and 0.78 or (self.Minimized and 0.88 or 1)
    }, 0.2)
end

if self.MinimizeIcon then
    tween(self.MinimizeIcon, {
        Rotation = self.Minimized and 180 or 0
    }, 0.28)
end

if self.MinimizeLineH then
    tween(self.MinimizeLineH, {
        BackgroundColor3 = active and accent or activeTheme.Muted,
        Size = UDim2.fromOffset(active and 16 or 14, 2)
    }, 0.18)
end

if self.MinimizeLineV then
    tween(self.MinimizeLineV, {
        BackgroundColor3 = active and accent or activeTheme.Muted,
        BackgroundTransparency = self.Minimized and 0 or 1
    }, 0.18)
end
end

function WindowClass:SetMinimized(state)
local minimized = state and true or false

if self.Minimized == minimized then
    return
end

self.Minimized = minimized

if not self.Visible then
    self.Visible = true
    self.Root.Visible = true
end

local duration = minimized and 0.3 or 0.36
local targetSize = minimized and self.MinimizedSize or (self.FullSize or self.Root.Size)
local targetPosition = keepTopPosition(self.Root.Position, self.Root.Size, targetSize)
targetPosition = clampToViewport(self.Root, targetPosition, self.IsMobile and 12 or 16, targetSize)

if not minimized then
    if self.TabRail then
        self.TabRail.Visible = true
    end

    if self.SelectedTab and self.SelectedTab.Page then
        self.SelectedTab.Page.Visible = true
    end
end

tween(self.Root, {
    Size = targetSize,
    Position = targetPosition
}, duration)

self:_refreshMinimizeVisual(false)

task.delay(duration * 0.72, function()
    if not self.Minimized then
        return
    end

    if self.TabRail then
        self.TabRail.Visible = false
    end

    for _, tab in ipairs(self.Tabs or {}) do
        if tab.Page then
            tab.Page.Visible = false
        end
    end
end)
end

