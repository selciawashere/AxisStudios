    tween(overlay, { BackgroundTransparency = 1 }, 0.34)
    tween(iconBack, { BackgroundTransparency = 1 }, 0.34)
    tween(iconStroke, { Transparency = 1 }, 0.34)
    tween(icon, { ImageTransparency = 1 }, 0.34)
    tween(title, { TextTransparency = 1 }, 0.28)
    tween(status, { TextTransparency = 1 }, 0.24)
    tween(track, { BackgroundTransparency = 1 }, 0.28)
    tween(fill, { BackgroundTransparency = 1 }, 0.28)
    tween(percent, { TextTransparency = 1 }, 0.24)
    tween(iconScale, { Scale = 0.82 }, 0.34)

    task.delay(0.36, function()
        if overlay then
            overlay:Destroy()
        end
    end)
end

task.spawn(function()
    tween(overlay, { BackgroundTransparency = 0.05 }, 0.28)
    tween(iconBack, { BackgroundTransparency = 0 }, 0.3)
    tween(iconStroke, { Transparency = 0.35 }, 0.3)
    tween(icon, { ImageTransparency = 0 }, 0.3)
    tween(title, { TextTransparency = 0 }, 0.28)
    tween(status, { TextTransparency = 0 }, 0.28)
    tween(track, { BackgroundTransparency = 0 }, 0.28)
    tween(fill, { BackgroundTransparency = 0 }, 0.28)
    tween(percent, { TextTransparency = 0 }, 0.28)
    tween(iconScale, { Scale = 1 }, 0.38)

    local stepDuration = duration / math.max(#steps, 1)

    for index, stepName in ipairs(steps) do
        local progress = index / #steps
        status.Text = tostring(stepName)
        percent.Text = tostring(math.floor(progress * 100 + 0.5)) .. "%"
        tween(fill, { Size = UDim2.fromScale(progress, 1) }, math.max(stepDuration * 0.82, 0.12))
        tween(iconScale, { Scale = index % 2 == 0 and 1.04 or 0.98 }, stepDuration * 0.5)
        task.wait(stepDuration)
    end

    status.Text = "Ready"
    percent.Text = "100%"
    tween(fill, { Size = UDim2.fromScale(1, 1) }, 0.16)
    tween(iconScale, { Scale = 1.06 }, 0.18)
    task.wait(0.16)

    fadeLoaderOut()
    self:_captureFadeState()
    self:_dissolveVisible(true)

    if self.ToggleButton then
        self.ToggleButton.Visible = true
        tween(self.ToggleButton, { BackgroundTransparency = 0 }, 0.24)
    end
end)

return overlay
end

