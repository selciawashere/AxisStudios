function WindowClass:_serializeControl(entry)
local object = entry.Object

if not object then
    return nil
end

if entry.Kind == "ColorPicker" and object.GetColor then
    return {
        Color = toHex(object:GetColor()),
        Rainbow = object.Rainbow == true
    }
end

if entry.Kind == "Keybind" and object.GetKey then
    local key = object:GetKey()
    return key and key.Name or nil
end

if object.GetValue then
    return object:GetValue()
end

return nil
end

function WindowClass:_applyControlValue(entry, value)
local object = entry.Object

if not object then
    return
end

if entry.Kind == "ColorPicker" then
    local color = type(value) == "table" and value.Color or value

    if object.SetColor and color then
        object:SetColor(color, true)
    end

    if type(value) == "table" and value.Rainbow ~= nil and object.SetRainbow then
        object:SetRainbow(value.Rainbow, true)
    end

    return
end

if entry.Kind == "Keybind" then
    if object.SetKey then
        object:SetKey(value, true)
    end

    return
end

if object.SetValue then
    object:SetValue(value, true)
end
end

function WindowClass:_registerControl(config, kind, object)
if type(config) ~= "table" or config.Save == false or config.NoSave == true then
    return object
end

local flag = config.Flag or config.SaveKey or config.Name or config.Title

if not flag then
    return object
end

flag = tostring(flag)
local entry = {
    Flag = flag,
    Kind = kind,
    Object = object
}

self.Flags[flag] = entry

if self.PendingValues and self.PendingValues[flag] ~= nil then
    self._loadingConfig = true
    self:_applyControlValue(entry, self.PendingValues[flag])
    self.PendingValues[flag] = nil
    self._loadingConfig = false
end

return object
end

function WindowClass:SaveConfig(name)
name = sanitizeName(name or self.ActiveConfig or "default")
self.ActiveConfig = name

    local data = {
        Library = Axis.Name,
        Version = Axis.Version,
        Theme = self.ThemeName or "Axis",
        Accent = toHex(self.Theme.Accent),
        AutoSave = self.AutoSave == true,
        ThemeColors = {},
        Values = {}
    }

    for token, color in pairs(self.Theme or {}) do
        if typeof(color) == "Color3" then
            data.ThemeColors[token] = toHex(color)
        end
    end

    for flag, entry in pairs(self.Flags or {}) do
        local value = self:_serializeControl(entry)

    if value ~= nil then
        data.Values[flag] = value
    end
end

local path = self:_configPath(name)

if fileApiReady() then
    return writeJson(path, data)
end

MEMORY_CONFIGS[path] = data
return true
end

function WindowClass:LoadConfig(name)
name = sanitizeName(name or self.ActiveConfig or "default")
local path = self:_configPath(name)
local data = readJson(path) or MEMORY_CONFIGS[path]

if type(data) ~= "table" then
    return false
end

self.ActiveConfig = name
self._loadingConfig = true

    if type(data.ThemeColors) == "table" then
        data.ThemeColors.Name = data.Theme or "Custom"
        self:SetTheme(data.ThemeColors, true)
    elseif data.Theme then
        self:SetTheme(data.Theme, true)
    end

if data.Accent then
    self:SetAccent(data.Accent)
end

if data.AutoSave ~= nil then
    self.AutoSave = data.AutoSave == true
end

for flag, value in pairs(data.Values or {}) do
    local entry = self.Flags and self.Flags[flag]

    if entry then
        self:_applyControlValue(entry, value)
    else
        self.PendingValues[flag] = value
    end
end

self._loadingConfig = false
return true
end

function WindowClass:DeleteConfig(name)
name = sanitizeName(name or self.ActiveConfig or "default")
local path = self:_configPath(name)
MEMORY_CONFIGS[path] = nil
return deleteFile(path)
end

function WindowClass:ListConfigs()
local configs = {}
local folder = self:_configFolder()

if type(listfiles) == "function" and (type(isfolder) ~= "function" or isfolder(folder)) then
    local ok, files = pcall(listfiles, folder)

    if ok and type(files) == "table" then
        for _, file in ipairs(files) do
            local name = tostring(file):match("([^/\\]+)%.json$")

            if name then
                table.insert(configs, name)
            end
        end
    end
end

for path in pairs(MEMORY_CONFIGS) do
    local prefix = folder .. "/"

    if path:sub(1, #prefix) == prefix then
        local name = path:match("([^/]+)%.json$")

        if name and not table.find(configs, name) then
            table.insert(configs, name)
        end
    end
end

if not table.find(configs, "default") then
    table.insert(configs, "default")
end

table.sort(configs)
return configs
end

