local ACTIVE_TWEENS = setmetatable({}, { __mode = "k" })

local function tween(instance, props, duration, style)
if not instance or not instance.Parent then
    return nil
end

local active = ACTIVE_TWEENS[instance]

if not active then
    active = {}
    ACTIVE_TWEENS[instance] = active
end

for property in pairs(props) do
    if active[property] then
        pcall(function()
            active[property]:Cancel()
        end)
    end
end

local ok, result = pcall(function()
    local info = TweenInfo.new(duration or 0.24, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local activeTween = TweenService:Create(instance, info, props)

    for property in pairs(props) do
        active[property] = activeTween
    end

    activeTween:Play()

    activeTween.Completed:Connect(function()
        for property in pairs(props) do
            if active[property] == activeTween then
                active[property] = nil
            end
        end
    end)

    return activeTween
end)

if ok then
    return result
end

for key, value in pairs(props) do
    instance[key] = value
end

return nil
end

local function roundTo(value, precision)
precision = precision or 0

if precision <= 0 then
    return math.floor(value + 0.5)
end

local multiplier = 10 ^ precision
return math.floor(value * multiplier + 0.5) / multiplier
end

local function formatNumber(value, precision)
precision = precision or 0

if precision <= 0 then
    return tostring(math.floor(value + 0.5))
end

return string.format("%." .. tostring(precision) .. "f", value)
end

local function getParent()
local ok, hui = pcall(function()
    if gethui then
        return gethui()
    end

    return nil
end)

if ok and hui then
    return hui
end

return LocalPlayer:WaitForChild("PlayerGui")
end

local function getViewportSize()
local camera = Workspace.CurrentCamera

if camera then
    return camera.ViewportSize
end

return Vector2.new(1280, 720)
end

local function getOffsetSize(size, fallback)
fallback = fallback or Vector2.new(620, 438)

if typeof(size) ~= "UDim2" then
    return fallback
end

return Vector2.new(
    size.X.Offset > 0 and size.X.Offset or fallback.X,
    size.Y.Offset > 0 and size.Y.Offset or fallback.Y
)
end

local function getFitScale(size, margin)
local viewport = getViewportSize()
local offsetSize = getOffsetSize(size)
margin = margin or 32

local scale = math.min(
    (viewport.X - margin) / math.max(offsetSize.X, 1),
    (viewport.Y - margin) / math.max(offsetSize.Y, 1),
    1
)

return math.clamp(scale, 0.55, 1)
end

local function lerpNumber(a, b, t)
return a + (b - a) * t
end

local function lerpUDim2(a, b, t)
return UDim2.new(
    lerpNumber(a.X.Scale, b.X.Scale, t),
    lerpNumber(a.X.Offset, b.X.Offset, t),
    lerpNumber(a.Y.Scale, b.Y.Scale, t),
    lerpNumber(a.Y.Offset, b.Y.Offset, t)
)
end

local function nearUDim2(a, b)
return math.abs(a.X.Scale - b.X.Scale) < 0.0001
    and math.abs(a.X.Offset - b.X.Offset) < 0.35
    and math.abs(a.Y.Scale - b.Y.Scale) < 0.0001
    and math.abs(a.Y.Offset - b.Y.Offset) < 0.35
end

local function keepTopPosition(position, fromSize, toSize)
return UDim2.new(
    position.X.Scale,
    position.X.Offset,
    position.Y.Scale + ((toSize.Y.Scale - fromSize.Y.Scale) * 0.5),
    position.Y.Offset + ((toSize.Y.Offset - fromSize.Y.Offset) * 0.5)
)
end

local function clampToViewport(frame, position, paddingAmount, sizeOverride)
local viewport = getViewportSize()
local size = sizeOverride and getOffsetSize(sizeOverride, frame.AbsoluteSize) or frame.AbsoluteSize
local scale = 1
paddingAmount = paddingAmount or 8

if frame:FindFirstChildOfClass("UIScale") then
    scale = frame:FindFirstChildOfClass("UIScale").Scale
end

size = Vector2.new(size.X * scale, size.Y * scale)

local x = position.X.Scale * viewport.X + position.X.Offset
local y = position.Y.Scale * viewport.Y + position.Y.Offset
local anchor = frame.AnchorPoint or Vector2.new(0, 0)
local minX = paddingAmount + (size.X * anchor.X)
local maxX = viewport.X - paddingAmount - (size.X * (1 - anchor.X))
local minY = paddingAmount + (size.Y * anchor.Y)
local maxY = viewport.Y - paddingAmount - (size.Y * (1 - anchor.Y))

if minX > maxX then
    x = viewport.X * 0.5
else
    x = math.clamp(x, minX, maxX)
end

if minY > maxY then
    y = viewport.Y * 0.5
else
    y = math.clamp(y, minY, maxY)
end

return UDim2.fromOffset(x, y)
end

local function makeDraggable(handle, frame, tracker, clampToScreen)
local dragging = false
local dragInput
local dragStart
local startPosition
local targetPosition = frame.Position
local settling = false

local function track(connection)
    if tracker and tracker._track then
        return tracker:_track(connection)
    end

    return connection
end

track(handle.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    dragging = true
    settling = true
    dragStart = input.Position
    targetPosition = frame.Position
    startPosition = frame.Position

    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            dragging = false
        end
    end)
end))

track(handle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end))

track(UserInputService.InputChanged:Connect(function(input)
    if input ~= dragInput or not dragging then
        return
    end

    local delta = input.Position - dragStart
    targetPosition = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )

    if clampToScreen then
        targetPosition = clampToViewport(frame, targetPosition, 10)
    end
end))

track(RunService.RenderStepped:Connect(function(dt)
    if not dragging and not settling then
        targetPosition = frame.Position
        return
    end

    if nearUDim2(frame.Position, targetPosition) then
        frame.Position = targetPosition
        if not dragging then
            settling = false
        end
        return
    end

    frame.Position = lerpUDim2(frame.Position, targetPosition, math.clamp(dt * 20, 0, 1))
end))
end

